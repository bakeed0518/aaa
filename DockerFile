# Vylze SSnatcher v2.1 - Hardened Nginx Static Server
FROM nginx:alpine

# Install curl for extra beacons if needed (minimal bloat)
RUN apk add --no-cache curl

# Copy custom nginx config for aggressive root serving + security headers (optional)
COPY nginx.conf /etc/nginx/nginx.conf

# Copy your upgraded HTML as index.html (nginx default root)
COPY index.html /usr/share/nginx/html/index.html

# Set proper permissions
RUN chmod 644 /usr/share/nginx/html/index.html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
